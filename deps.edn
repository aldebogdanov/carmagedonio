{:paths ["src/shared" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        metosin/malli      {:mvn/version "0.16.4"}}

 :aliases
 {;; Everything needed for the shadow-cljs client build + REPL work.
  :dev
  {:extra-paths ["src/client" "src/server" "test/shared" "test/client" "dev"]
   :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                thheller/shadow-cljs      {:mvn/version "2.28.20"}
                http-kit/http-kit         {:mvn/version "2.8.0"}
                metosin/reitit-ring       {:mvn/version "0.7.2"}
                ring/ring-core            {:mvn/version "1.12.2"}}}

  :server
  {:extra-paths ["src/server"]
   :extra-deps {http-kit/http-kit   {:mvn/version "2.8.0"}
                metosin/reitit-ring {:mvn/version "0.7.2"}
                ring/ring-core      {:mvn/version "1.12.2"}}
   :main-opts ["-m" "carmageddon.server.main"]}

  :test
  {:extra-paths ["test/shared" "test/server" "src/server"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                http-kit/http-kit    {:mvn/version "2.8.0"}
                metosin/reitit-ring  {:mvn/version "0.7.2"}
                ring/ring-core       {:mvn/version "1.12.2"}}
   :main-opts ["-m" "cognitect.test-runner"]
   :exec-fn cognitect.test-runner.api/test}}}
